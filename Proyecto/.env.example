# Copia este archivo como .env (junto a docker-compose.yml) y ajusta los valores. NUNCA subas .env a git.

# --- Django ---
# DJANGO_DEBUG=True
# DJANGO_SECRET_KEY=pon-aqui-una-clave-larga-y-aleatoria
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- API Flask opcional (docker-compose.api.yml) ---
# Clave compartida Django <-> API para firmar las peticiones internas. Mínimo 32 caracteres.
# Genérala en PowerShell:  -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
# AGROASESOR_INTERNAL_SECRET=

# --- Correo (recuperación de contraseña) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=AgroAsesor <noreply@tudominio.cl>
